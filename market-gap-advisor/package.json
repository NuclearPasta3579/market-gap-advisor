{
  "name": "@local/market-gap-advisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finds installable plugins in the user's plugin indexes when a capability is missing, and asks before installing.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills/*.md",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "DESIGN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
